{
  "name": "@dreamlake/uikit",
  "version": "0.2.13",
  "description": "DreamLake UI kit \u2014 primitives + tokens",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./styles.css": "./src/styles.css",
    "./list": "./src/list.ts",
    "./outline": "./src/outline.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./list": {
        "types": "./dist/list.d.ts",
        "import": "./dist/list.js"
      },
      "./outline": {
        "types": "./dist/outline.d.ts",
        "import": "./dist/outline.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lucide-react": ">=1.0.0",
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": false
    }
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
